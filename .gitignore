# ---------------------------------------------------------------------------
# CodeSlice - repository-wide ignores
# Do NOT ignore docs/ or packaging/specs/ - both are source, not build output.
# ---------------------------------------------------------------------------

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
.venv/
venv/
env/
ENV/
backend/.venv/

# Packaging / distribution
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/
MANIFEST

# PyInstaller write-scope artifacts (never tracked)
packaging/build/
packaging/dist-backend/
packaging/specs/*.spec.bak
*.manifest

# Test / tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# --- Node / Electron ---------------------------------------------------------
node_modules/
frontend/dist/
# generated by frontend/scripts/copy-monaco.mjs from node_modules on every build
frontend/public/monaco/
desktop/dist/
desktop/dist-electron/
desktop/release/
# staged copy of the PyInstaller bundle (gitignore has no inline comments)
desktop/resources/backend/
.vite/
.eslintcache
*.tsbuildinfo

# npm/yarn/pnpm debris
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/

# --- Runtime data ------------------------------------------------------------
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
.codeslice/
.devdata/
.e2edata/
.e2e_ready.txt

# --- Environment / secrets ---------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets.local.*
frontend/.env.local

# --- OS / editor junk --------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

.idea/
.vscode/
!.vscode/extensions.json
*.swp
*.swo
*~

# --- Logs --------------------------------------------------------------------
*.log
*.err
# dev-server stdout captured by local helper scripts
/*.out
logs/

# --- Local verification artifacts (screenshots, backend stderr, ACL repair) --
.shots/
acl-recovery/

# --- Release build outputs ---------------------------------------------------
desktop/release-linux/
packaging/dist-backend-linux/
